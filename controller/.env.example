# docker compose's settings for the controller (compose.yaml): copy to .env (not in git) and
# edit. .env is read from this directory. ESPDNS_UID and ESPDNS_GID are required (compose
# refuses to run without them); the others have defaults.

# The user and group the controller runs as: the owner of the data directory, so the files
# it writes there stay yours. Yours: id -u and id -g (set them: no guess fits every system).
ESPDNS_UID=
ESPDNS_GID=

# The dashboard's address: localhost only (127.0.0.1, [::1] or localhost), any port.
ESPDNS_LISTEN=127.0.0.1:8480

# The data directory on the host, mounted at /data: relative to this directory, or a full
# path. It must exist and be owned by ESPDNS_UID (mkdir -m 700 data). Keep it outside the
# checkout: it holds the release key (docs/getting-started.md).
ESPDNS_DATA=./data

# Resource limits (compose.yaml): the container's memory, the Go runtime's soft limit inside
# it (about nine tenths of the memory: the collector works harder near it instead of the
# controller being killed at the limit), and its processes and threads. Compiling a
# blocklist is the most memory it needs, about 220 bytes a domain at its peak: raise both
# together for lists of more than about 8 million domains.
#ESPDNS_MEM_LIMIT=2g
#ESPDNS_GOMEMLIMIT=1800MiB
#ESPDNS_PIDS_LIMIT=256

# The image's name, and the container's.
#ESPDNS_IMAGE=espdns-controller
#ESPDNS_CONTAINER=espdns-controller
